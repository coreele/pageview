{
  "name": "pageview",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "capture-fixtures": "pnpm --filter server exec tsx ../../scripts/capture-fixtures.ts",
    "test:integration": "pnpm --filter server test:integration",
    "test:wal": "pnpm --filter server test:wal",
    "test:e2e": "pnpm --filter server build && pnpm --filter web build && pnpm --filter server exec tsc --noEmit -p ../../tsconfig.e2e.json && playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
